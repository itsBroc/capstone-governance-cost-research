{
	"name": "ds_processed_parquet",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_adls_capstone",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"GovernanceTier": {
				"type": "string"
			},
			"ScenarioID": {
				"type": "string"
			},
			"TableName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@{dataset().TableName}.parquet",
					"type": "Expression"
				},
				"folderPath": {
					"value": "data-processed/@{dataset().GovernanceTier}/@{dataset().ScenarioID}",
					"type": "Expression"
				},
				"fileSystem": "capstone"
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}