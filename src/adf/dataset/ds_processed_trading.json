{
	"name": "ds_processed_trading",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_adls_capstone",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"GovernanceMode": {
				"type": "string"
			},
			"ScenarioID": {
				"type": "string"
			},
			"Repetition": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
