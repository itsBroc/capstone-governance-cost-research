{
	"name": "df_goverened",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_raw_region",
						"type": "DatasetReference"
					},
					"name": "sourceREGION"
				},
				{
					"dataset": {
						"referenceName": "ds_raw_trading",
						"type": "DatasetReference"
					},
					"name": "sourceTRADING"
				},
				{
					"dataset": {
						"referenceName": "ds_raw_du",
						"type": "DatasetReference"
					},
					"name": "sourceDU"
				},
				{
					"dataset": {
						"referenceName": "ds_raw_scada",
						"type": "DatasetReference"
					},
					"name": "sourceSCADA"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_processed_scada",
						"type": "DatasetReference"
					},
					"name": "sinkSCADA"
				},
				{
					"dataset": {
						"referenceName": "ds_processed_trading",
						"type": "DatasetReference"
					},
					"name": "sinkTRADING"
				},
				{
					"dataset": {
						"referenceName": "ds_processed_region",
						"type": "DatasetReference"
					},
					"name": "sinkREGION"
				},
				{
					"dataset": {
						"referenceName": "ds_processed_du",
						"type": "DatasetReference"
					},
					"name": "sinkDU"
				},
				{
					"dataset": {
						"referenceName": "ds_faulty_scada",
						"type": "DatasetReference"
					},
					"name": "sinkFaultSCADA"
				},
				{
					"dataset": {
						"referenceName": "ds_faulty_region",
						"type": "DatasetReference"
					},
					"name": "sinkFaultREGION"
				},
				{
					"dataset": {
						"referenceName": "ds_faulty_trading",
						"type": "DatasetReference"
					},
					"name": "sinkFaultTRADING"
				},
				{
					"dataset": {
						"referenceName": "ds_faulty_du",
						"type": "DatasetReference"
					},
					"name": "sinkFaultDU"
				}
			],
			"transformations": [
				{
					"name": "selectREGION"
				},
				{
					"name": "selectTRADING"
				},
				{
					"name": "selectDU"
				},
				{
					"name": "castTrading"
				},
				{
					"name": "derivedTrading"
				},
				{
					"name": "selectSCADA"
				},
				{
					"name": "castSCADA"
				},
				{
					"name": "derivedSCADA"
				},
				{
					"name": "castREGION"
				},
				{
					"name": "derivedREGION"
				},
				{
					"name": "castDU"
				},
				{
					"name": "derivedDU"
				},
				{
					"name": "assertSCADA"
				},
				{
					"name": "assertREGION"
				},
				{
					"name": "assertTRADING"
				},
				{
					"name": "assertDU"
				},
				{
					"name": "splitScada"
				},
				{
					"name": "derivedFaultSCADA"
				},
				{
					"name": "splitREGION"
				},
				{
					"name": "derivedFaultRegion"
				},
				{
					"name": "split1"
				},
				{
					"name": "splitDU"
				},
				{
					"name": "aggregateDU"
				},
				{
					"name": "joinDU"
				},
				{
					"name": "derivedFaultTRADING"
				},
				{
					"name": "derivedFaultDU"
				},
				{
					"name": "filterDuplicateDU"
				}
			],
			"scriptLines": [
				"parameters{",
				"     GovernanceMode as string,",
				"     ScenarioID as string,",
				"     Repetition as string",
				"}",
				"source(output(",
				"          SETTLEMENTDATE as string,",
				"          RUNNO as string,",
				"          REGIONID as string,",
				"          DISPATCHINTERVAL as string,",
				"          INTERVENTION as string,",
				"          TOTALDEMAND as string,",
				"          AVAILABLEGENERATION as string,",
				"          AVAILABLELOAD as string,",
				"          DEMANDFORECAST as string,",
				"          DISPATCHABLEGENERATION as string,",
				"          DISPATCHABLELOAD as string,",
				"          NETINTERCHANGE as string,",
				"          EXCESSGENERATION as string,",
				"          LOWER5MINDISPATCH as string,",
				"          LOWER5MINIMPORT as string,",
				"          LOWER5MINLOCALDISPATCH as string,",
				"          LOWER5MINLOCALPRICE as string,",
				"          LOWER5MINLOCALREQ as string,",
				"          LOWER5MINPRICE as string,",
				"          LOWER5MINREQ as string,",
				"          LOWER5MINSUPPLYPRICE as string,",
				"          LOWER60SECDISPATCH as string,",
				"          LOWER60SECIMPORT as string,",
				"          LOWER60SECLOCALDISPATCH as string,",
				"          LOWER60SECLOCALPRICE as string,",
				"          LOWER60SECLOCALREQ as string,",
				"          LOWER60SECPRICE as string,",
				"          LOWER60SECREQ as string,",
				"          LOWER60SECSUPPLYPRICE as string,",
				"          LOWER6SECDISPATCH as string,",
				"          LOWER6SECIMPORT as string,",
				"          LOWER6SECLOCALDISPATCH as string,",
				"          LOWER6SECLOCALPRICE as string,",
				"          LOWER6SECLOCALREQ as string,",
				"          LOWER6SECPRICE as string,",
				"          LOWER6SECREQ as string,",
				"          LOWER6SECSUPPLYPRICE as string,",
				"          RAISE5MINDISPATCH as string,",
				"          RAISE5MINIMPORT as string,",
				"          RAISE5MINLOCALDISPATCH as string,",
				"          RAISE5MINLOCALPRICE as string,",
				"          RAISE5MINLOCALREQ as string,",
				"          RAISE5MINPRICE as string,",
				"          RAISE5MINREQ as string,",
				"          RAISE5MINSUPPLYPRICE as string,",
				"          RAISE60SECDISPATCH as string,",
				"          RAISE60SECIMPORT as string,",
				"          RAISE60SECLOCALDISPATCH as string,",
				"          RAISE60SECLOCALPRICE as string,",
				"          RAISE60SECLOCALREQ as string,",
				"          RAISE60SECPRICE as string,",
				"          RAISE60SECREQ as string,",
				"          RAISE60SECSUPPLYPRICE as string,",
				"          RAISE6SECDISPATCH as string,",
				"          RAISE6SECIMPORT as string,",
				"          RAISE6SECLOCALDISPATCH as string,",
				"          RAISE6SECLOCALPRICE as string,",
				"          RAISE6SECLOCALREQ as string,",
				"          RAISE6SECPRICE as string,",
				"          RAISE6SECREQ as string,",
				"          RAISE6SECSUPPLYPRICE as string,",
				"          AGGEGATEDISPATCHERROR as string,",
				"          AGGREGATEDISPATCHERROR as string,",
				"          LASTCHANGED as string,",
				"          INITIALSUPPLY as string,",
				"          CLEAREDSUPPLY as string,",
				"          LOWERREGIMPORT as string,",
				"          LOWERREGLOCALDISPATCH as string,",
				"          LOWERREGLOCALREQ as string,",
				"          LOWERREGREQ as string,",
				"          RAISEREGIMPORT as string,",
				"          RAISEREGLOCALDISPATCH as string,",
				"          RAISEREGLOCALREQ as string,",
				"          RAISEREGREQ as string,",
				"          RAISE5MINLOCALVIOLATION as string,",
				"          RAISEREGLOCALVIOLATION as string,",
				"          RAISE60SECLOCALVIOLATION as string,",
				"          RAISE6SECLOCALVIOLATION as string,",
				"          LOWER5MINLOCALVIOLATION as string,",
				"          LOWERREGLOCALVIOLATION as string,",
				"          LOWER60SECLOCALVIOLATION as string,",
				"          LOWER6SECLOCALVIOLATION as string,",
				"          RAISE5MINVIOLATION as string,",
				"          RAISEREGVIOLATION as string,",
				"          RAISE60SECVIOLATION as string,",
				"          RAISE6SECVIOLATION as string,",
				"          LOWER5MINVIOLATION as string,",
				"          LOWERREGVIOLATION as string,",
				"          LOWER60SECVIOLATION as string,",
				"          LOWER6SECVIOLATION as string,",
				"          RAISE6SECACTUALAVAILABILITY as string,",
				"          RAISE60SECACTUALAVAILABILITY as string,",
				"          RAISE5MINACTUALAVAILABILITY as string,",
				"          RAISEREGACTUALAVAILABILITY as string,",
				"          LOWER6SECACTUALAVAILABILITY as string,",
				"          LOWER60SECACTUALAVAILABILITY as string,",
				"          LOWER5MINACTUALAVAILABILITY as string,",
				"          LOWERREGACTUALAVAILABILITY as string,",
				"          LORSURPLUS as string,",
				"          LRCSURPLUS as string,",
				"          TOTALINTERMITTENTGENERATION as string,",
				"          DEMAND_AND_NONSCHEDGEN as string,",
				"          UIGF as string,",
				"          SEMISCHEDULE_CLEAREDMW as string,",
				"          SEMISCHEDULE_COMPLIANCEMW as string,",
				"          SS_SOLAR_UIGF as string,",
				"          SS_WIND_UIGF as string,",
				"          SS_SOLAR_CLEAREDMW as string,",
				"          SS_WIND_CLEAREDMW as string,",
				"          SS_SOLAR_COMPLIANCEMW as string,",
				"          SS_WIND_COMPLIANCEMW as string,",
				"          WDR_INITIALMW as string,",
				"          WDR_AVAILABLE as string,",
				"          WDR_DISPATCHED as string,",
				"          SS_SOLAR_AVAILABILITY as string,",
				"          SS_WIND_AVAILABILITY as string,",
				"          RAISE1SECLOCALDISPATCH as string,",
				"          LOWER1SECLOCALDISPATCH as string,",
				"          RAISE1SECACTUALAVAILABILITY as string,",
				"          LOWER1SECACTUALAVAILABILITY as string,",
				"          BDU_ENERGY_STORAGE as string,",
				"          BDU_MIN_AVAIL as string,",
				"          BDU_MAX_AVAIL as string,",
				"          BDU_CLEAREDMW_GEN as string,",
				"          BDU_CLEAREDMW_LOAD as string,",
				"          BDU_INITIAL_ENERGY_STORAGE as string,",
				"          DECGEN_INITIAL_ENERGY_STORAGE as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false) ~> sourceREGION",
				"source(output(",
				"          SETTLEMENTDATE as string,",
				"          RUNNO as string,",
				"          REGIONID as string,",
				"          PERIODID as string,",
				"          RRP as string,",
				"          EEP as string,",
				"          INVALIDFLAG as string,",
				"          LASTCHANGED as string,",
				"          ROP as string,",
				"          RAISE6SECRRP as string,",
				"          RAISE6SECROP as string,",
				"          RAISE60SECRRP as string,",
				"          RAISE60SECROP as string,",
				"          RAISE5MINRRP as string,",
				"          RAISE5MINROP as string,",
				"          RAISEREGRRP as string,",
				"          RAISEREGROP as string,",
				"          LOWER6SECRRP as string,",
				"          LOWER6SECROP as string,",
				"          LOWER60SECRRP as string,",
				"          LOWER60SECROP as string,",
				"          LOWER5MINRRP as string,",
				"          LOWER5MINROP as string,",
				"          LOWERREGRRP as string,",
				"          LOWERREGROP as string,",
				"          PRICE_STATUS as string,",
				"          RAISE1SECRRP as string,",
				"          RAISE1SECROP as string,",
				"          LOWER1SECRRP as string,",
				"          LOWER1SECROP as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false) ~> sourceTRADING",
				"source(output(",
				"          DUID as string,",
				"          START_DATE as string,",
				"          END_DATE as string,",
				"          DISPATCHTYPE as string,",
				"          CONNECTIONPOINTID as string,",
				"          REGIONID as string,",
				"          STATIONID as string,",
				"          PARTICIPANTID as string,",
				"          LASTCHANGED as string,",
				"          TRANSMISSIONLOSSFACTOR as string,",
				"          STARTTYPE as string,",
				"          DISTRIBUTIONLOSSFACTOR as string,",
				"          MINIMUM_ENERGY_PRICE as string,",
				"          MAXIMUM_ENERGY_PRICE as string,",
				"          SCHEDULE_TYPE as string,",
				"          MIN_RAMP_RATE_UP as string,",
				"          MIN_RAMP_RATE_DOWN as string,",
				"          MAX_RAMP_RATE_UP as string,",
				"          MAX_RAMP_RATE_DOWN as string,",
				"          IS_AGGREGATED as string,",
				"          DISPATCHSUBTYPE as string,",
				"          ADG_ID as string,",
				"          LOAD_MINIMUM_ENERGY_PRICE as string,",
				"          LOAD_MAXIMUM_ENERGY_PRICE as string,",
				"          LOAD_MIN_RAMP_RATE_UP as string,",
				"          LOAD_MIN_RAMP_RATE_DOWN as string,",
				"          LOAD_MAX_RAMP_RATE_UP as string,",
				"          LOAD_MAX_RAMP_RATE_DOWN as string,",
				"          SECONDARY_TLF as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false) ~> sourceDU",
				"source(output(",
				"          SETTLEMENTDATE as string,",
				"          DUID as string,",
				"          SCADAVALUE as string,",
				"          LASTCHANGED as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false) ~> sourceSCADA",
				"sourceREGION select(mapColumn(",
				"          SETTLEMENTDATE,",
				"          RUNNO,",
				"          REGIONID,",
				"          DISPATCHINTERVAL,",
				"          TOTALDEMAND,",
				"          AVAILABLEGENERATION,",
				"          AVAILABLELOAD,",
				"          DEMANDFORECAST,",
				"          DISPATCHABLEGENERATION,",
				"          DISPATCHABLELOAD,",
				"          NETINTERCHANGE,",
				"          LASTCHANGED",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectREGION",
				"sourceTRADING select(mapColumn(",
				"          SETTLEMENTDATE,",
				"          RUNNO,",
				"          REGIONID,",
				"          PERIODID,",
				"          RRP,",
				"          EEP,",
				"          INVALIDFLAG,",
				"          LASTCHANGED,",
				"          ROP,",
				"          PRICE_STATUS",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTRADING",
				"sourceDU select(mapColumn(",
				"          DUID,",
				"          START_DATE,",
				"          END_DATE,",
				"          DISPATCHTYPE,",
				"          CONNECTIONPOINTID,",
				"          REGIONID,",
				"          STATIONID,",
				"          PARTICIPANTID,",
				"          LASTCHANGED,",
				"          TRANSMISSIONLOSSFACTOR,",
				"          DISTRIBUTIONLOSSFACTOR,",
				"          MINIMUM_ENERGY_PRICE,",
				"          MAXIMUM_ENERGY_PRICE,",
				"          SCHEDULE_TYPE,",
				"          DISPATCHSUBTYPE",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectDU",
				"split1@ValidTRADING cast(output(",
				"          SETTLEMENTDATE as timestamp 'yyyy/MM/dd HH:mm:ss',",
				"          RUNNO as integer,",
				"          REGIONID as string,",
				"          PERIODID as integer,",
				"          RRP as double,",
				"          EEP as double,",
				"          INVALIDFLAG as integer,",
				"          LASTCHANGED as timestamp 'yyyy/MM/dd HH:mm:ss',",
				"          ROP as double,",
				"          PRICE_STATUS as string",
				"     ),",
				"     errors: false) ~> castTrading",
				"castTrading derive(TRADE_DATE = toDate(SETTLEMENTDATE),",
				"          PRICE_SPREAD = RRP - ROP) ~> derivedTrading",
				"sourceSCADA select(mapColumn(",
				"          SETTLEMENTDATE,",
				"          DUID,",
				"          SCADAVALUE,",
				"          LASTCHANGED",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectSCADA",
				"splitScada@ValidSCADA cast(output(",
				"          SETTLEMENTDATE as timestamp 'yyyy/MM/dd HH:mm:ss',",
				"          DUID as string,",
				"          SCADAVALUE as double,",
				"          LASTCHANGED as timestamp 'yyyy/MM/dd HH:mm:ss'",
				"     ),",
				"     errors: false) ~> castSCADA",
				"castSCADA derive(TRADE_DATE = toDate(SETTLEMENTDATE),",
				"          INTERVAL_MWH = SCADAVALUE * (5.0 / 60.0)) ~> derivedSCADA",
				"splitREGION@ValidREGION cast(output(",
				"          SETTLEMENTDATE as timestamp 'yyyy/MM/dd HH:mm:ss',",
				"          RUNNO as integer,",
				"          REGIONID as string,",
				"          DISPATCHINTERVAL as integer,",
				"          TOTALDEMAND as double,",
				"          AVAILABLEGENERATION as double,",
				"          AVAILABLELOAD as double,",
				"          DEMANDFORECAST as double,",
				"          DISPATCHABLEGENERATION as double,",
				"          DISPATCHABLELOAD as double,",
				"          NETINTERCHANGE as double,",
				"          LASTCHANGED as timestamp 'yyyy/MM/dd HH:mm:ss'",
				"     ),",
				"     errors: false) ~> castREGION",
				"castREGION derive(TRADE_DATE = toDate(SETTLEMENTDATE),",
				"          NET_DEMAND = TOTALDEMAND - NETINTERCHANGE,",
				"          GENERATION_MARGIN = AVAILABLEGENERATION - TOTALDEMAND) ~> derivedREGION",
				"splitDU@ValidDU cast(output(",
				"          DUID as string,",
				"          START_DATE as timestamp 'yyyy/MM/dd HH:mm:ss',",
				"          END_DATE as timestamp 'yyyy/MM/dd HH:mm:ss',",
				"          DISPATCHTYPE as string,",
				"          CONNECTIONPOINTID as string,",
				"          REGIONID as string,",
				"          STATIONID as string,",
				"          PARTICIPANTID as string,",
				"          LASTCHANGED as timestamp 'yyyy/MM/dd HH:mm:ss',",
				"          TRANSMISSIONLOSSFACTOR as double,",
				"          DISTRIBUTIONLOSSFACTOR as double,",
				"          MINIMUM_ENERGY_PRICE as double,",
				"          MAXIMUM_ENERGY_PRICE as double,",
				"          SCHEDULE_TYPE as string,",
				"          DISPATCHSUBTYPE as string",
				"     ),",
				"     errors: false) ~> castDU",
				"castDU derive(PRICE_RANGE = MAXIMUM_ENERGY_PRICE - MINIMUM_ENERGY_PRICE) ~> derivedDU",
				"selectSCADA assert(expectTrue(!isNull(SETTLEMENTDATE) && !isNull(DUID) && !isNull(SCADAVALUE), false, 'SCADA_REQUIRED_FIELDS'),",
				"     expectTrue(isTimestamp(SETTLEMENTDATE, 'yyyy/MM/dd HH:mm:ss'), false, 'SCADA_VALID_TIMESTAMP'),",
				"     expectTrue(isDouble(SCADAVALUE), false, 'SCADA_NUMERIC_VALUE')) ~> assertSCADA",
				"selectREGION assert(expectTrue(!isNull(SETTLEMENTDATE) && !isNull(REGIONID) && !isNull(TOTALDEMAND) && !isNull(NETINTERCHANGE), false, 'REGION_REQUIRED_FIELDS'),",
				"     expectTrue(isTimestamp(SETTLEMENTDATE, 'yyyy/MM/dd HH:mm:ss'), false, 'REGION_VALID_TIMESTAMP'),",
				"     expectTrue(isDouble(TOTALDEMAND) && isDouble(NETINTERCHANGE) && isDouble(AVAILABLEGENERATION), false, 'REGION_NUMERIC_DEMAND'),",
				"     expectTrue(toDouble(TOTALDEMAND) >= 0, false, 'REGION_NONNEGATIVE_DEMAND')) ~> assertREGION",
				"selectTRADING assert(expectTrue(!isNull(SETTLEMENTDATE) && !isNull(REGIONID) && !isNull(RRP), false, 'TRADING_REQUIRED_FIELDS'),",
				"     expectTrue(isTimestamp(SETTLEMENTDATE, 'yyyy/MM/dd HH:mm:ss'), false, 'TRADING_VALID_TIMESTAMP'),",
				"     expectTrue(isDouble(RRP) && (isNull(ROP) || isDouble(ROP)), false, 'TRADING_NUMERIC_PRICE')) ~> assertTRADING",
				"selectDU assert(expectTrue(!isNull(DUID) &&\r",
				"!isNull(START_DATE) &&\r",
				"!isNull(END_DATE) &&\r",
				"!isNull(REGIONID), false, 'DU_REQUIRED_FIELDS'),",
				"     expectTrue(isTimestamp(START_DATE, 'yyyy/MM/dd HH:mm:ss'), false, 'DU_VALID_START_DATE'),",
				"     expectTrue(isTimestamp(END_DATE, 'yyyy/MM/dd HH:mm:ss'), false, 'DU_VALID_END_DATE')) ~> assertDU",
				"assertSCADA split(!hasError(),",
				"     disjoint: false) ~> splitScada@(ValidSCADA, InvalidSCADA)",
				"splitScada@InvalidSCADA derive(FAULT_SOURCE = 'DISPATCH_UNIT_SCADA',",
				"          FAULT_REASON = 'SCADA_VALIDATION_FAILED',",
				"          GOVERNANCE_STATUS = 'REJECTED',",
				"          SCENARIO_ID = $ScenarioID,",
				"          REPETITION = $Repetition) ~> derivedFaultSCADA",
				"assertREGION split(!hasError(),",
				"     disjoint: false) ~> splitREGION@(ValidREGION, InvalidREGION)",
				"splitREGION@InvalidREGION derive(FAULT_SOURCE = 'DISPATCH_REGION_SUM',",
				"          FAULT_REASON = 'REGION_VALIDATION_FAILED',",
				"          GOVERNANCE_STATUS = 'REJECTED',",
				"          SCENARIO_ID = $ScenarioID,",
				"          REPETITION = $Repetition) ~> derivedFaultRegion",
				"assertTRADING split(!hasError(),",
				"     disjoint: false) ~> split1@(ValidTRADING, InvalidTRADING)",
				"joinDU split(!hasError() && isNull(DUID_COUNT),",
				"     disjoint: false) ~> splitDU@(ValidDU, InvalidDU)",
				"assertDU aggregate(groupBy(DUID),",
				"     DUID_COUNT = count()) ~> aggregateDU",
				"assertDU, filterDuplicateDU join(selectDU@DUID == aggregateDU@DUID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinDU",
				"split1@InvalidTRADING derive(FAULT_SOURCE = 'TRADING_PRICE',",
				"          FAULT_REASON = 'TRADING_VALIDATION_FAILED',",
				"          GOVERNANCE_STATUS = 'REJECTED',",
				"          SCENARIO_ID = $ScenarioID,",
				"          REPETITION = $Repetition) ~> derivedFaultTRADING",
				"splitDU@InvalidDU derive() ~> derivedFaultDU",
				"aggregateDU filter(DUID_COUNT > 1) ~> filterDuplicateDU",
				"derivedSCADA sink(allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     format: 'parquet',",
				"     umask: 0022,",
