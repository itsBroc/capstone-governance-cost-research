						{
							"name": "Run_Propagation_Consumer",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "If_Governed",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "Scenario",
									"value": "@{item().scenario}"
								},
								{
									"name": "GovernanceMode",
									"value": "@{item().mode}"
								},
								{
									"name": "Repetition",
									"value": "@{item().repetition}"
								}
							],
							"linkedServiceName": {
								"referenceName": "ls_synapse_capstone",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "WITH scada AS (\n    SELECT\n        SETTLEMENTDATE,\n        DUID,\n        SCADAVALUE,\n        INTERVAL_MWH\n    FROM OPENROWSET(\n        BULK 'https://stcapstonegovdev01.dfs.core.windows.net/capstone/data-processed/@{item().mode}/@{item().scenario}/@{item().repetition}/DISPATCH_UNIT_SCADA/*.parquet',\n        FORMAT = 'PARQUET'\n    ) AS s\n),\n\ndu AS (\n    SELECT\n        DUID,\n        REGIONID\n    FROM OPENROWSET(\n        BULK 'https://stcapstonegovdev01.dfs.core.windows.net/capstone/data-processed/@{item().mode}/@{item().scenario}/@{item().repetition}/DU_DETAIL_SUMMARY/*.parquet',\n        FORMAT = 'PARQUET'\n    ) AS d\n),\n\nregion_sum AS (\n    SELECT\n        SETTLEMENTDATE,\n        REGIONID,\n        TOTALDEMAND,\n        NET_DEMAND,\n        GENERATION_MARGIN\n    FROM OPENROWSET(\n        BULK 'https://stcapstonegovdev01.dfs.core.windows.net/capstone/data-processed/@{item().mode}/@{item().scenario}/@{item().repetition}/DISPATCH_REGION_SUM/*.parquet',\n        FORMAT = 'PARQUET'\n    ) AS r\n),\n\ntrading_price AS (\n    SELECT\n        SETTLEMENTDATE,\n        REGIONID,\n        RRP,\n        PRICE_STATUS\n        FROM OPENROWSET(\n        BULK 'https://stcapstonegovdev01.dfs.core.windows.net/capstone/data-processed/@{item().mode}/@{item().scenario}/@{item().repetition}/TRADING_PRICE/*.parquet',\n            FORMAT = 'PARQUET'\n    ) AS t\n),\n\nconsumer AS (\n    SELECT\n        s.SETTLEMENTDATE,\n        s.DUID,\n        d.REGIONID,\n        s.SCADAVALUE,\n        s.INTERVAL_MWH,\n        r.TOTALDEMAND,\n        r.NET_DEMAND,\n        r.GENERATION_MARGIN,\n        t.RRP,\n        t.PRICE_STATUS\n    FROM scada AS s\n\n    LEFT JOIN du AS d\n        on s.DUID = d.DUID\n    \n    LEFT JOIN region_sum AS r\n        ON d.REGIONID = r.REGIONID\n        AND s.SETTLEMENTDATE = r.SETTLEMENTDATE\n\n    LEFT JOIN trading_price AS t\n        ON d.REGIONID = t.REGIONID\n        AND s.SETTLEMENTDATE = t.SETTLEMENTDATE\n),\n\nconsumer_report AS (\n    SELECT \n        SETTLEMENTDATE,\n        REGIONID,\n        COUNT(*) AS RECORD_COUNT,\n        COUNT(DISTINCT DUID) AS UNIT_COUNT,\n        SUM(INTERVAL_MWH) AS TOTAL_INTERVAL_MWH,\n        AVG(SCADAVALUE) AS AVG_SCADA_VALUE,\n        MAX(TOTALDEMAND) AS TOTALDEMAND,\n        MAX(NET_DEMAND) AS NET_DEMAND,\n        MAX(GENERATION_MARGIN) AS REGION_GENERATION_MARGIN,\n        MAX(RRP) AS RRP,\n        SUM(INTERVAL_MWH) * MAX(RRP) AS ESTIMATED_INTERVAL_VALUE,\n        SUM(CASE WHEN REGIONID IS NULL THEN 1 ELSE 0 END) AS NULL_REGION_ROWS,\n        SUM(CASE WHEN TOTALDEMAND IS NULL THEN 1 ELSE 0 END) AS NULL_DEMAND_ROWS,\n        SUM(CASE WHEN RRP IS NULL THEN 1 ELSE 0 END) AS NULL_PRICE_ROWS,\n        SUM(CASE WHEN SCADAVALUE IS NULL THEN 1 ELSE 0 END) AS NULL_SCADA_ROWS,\n        SUM(CASE WHEN INTERVAL_MWH IS NULL THEN 1 ELSE 0 END) AS NULL_MWH_ROWS  \n\n    FROM consumer\n    GROUP BY\n        SETTLEMENTDATE,\n        REGIONID\n)\n\nSELECT\n    COUNT(*) AS REPORT_ROWS,\n    SUM(RECORD_COUNT) AS CONSUMER_ROWS,\n    SUM(UNIT_COUNT) AS UNIT_COUNT_SUM,\n    SUM(TOTAL_INTERVAL_MWH) AS TOTAL_MWH,\n    SUM(ESTIMATED_INTERVAL_VALUE) AS TOTAL_VALUE,\n    SUM(NULL_SCADA_ROWS) AS NULL_SCADA_ROWS,\n    SUM(NULL_MWH_ROWS) AS NULL_MWH_ROWS,\n    SUM(NULL_REGION_ROWS) AS NULL_REGION_ROWS,\n    SUM(NULL_DEMAND_ROWS) AS NULL_DEMAND_ROWS,\n    SUM(NULL_PRICE_ROWS) AS NULL_PRICE_ROWS\nFROM consumer_report;",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
